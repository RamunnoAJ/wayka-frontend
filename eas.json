{
  "cli": {
    "version": ">= 23.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.12.0",
      "env": {
        "EXPO_PUBLIC_USE_RN_FETCH": "1",
        "EXPO_PUBLIC_MAPAS_PROVEEDOR": "google"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "env": {
        "APP_VARIANTE": "desarrollo"
      },
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      },
      "channel": "development"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-staging.wayka.app",
        "EXPO_PUBLIC_USE_RN_FETCH": "1"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.wayka.app",
        "EXPO_PUBLIC_USE_RN_FETCH": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
