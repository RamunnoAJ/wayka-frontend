# URL base del backend de Wayka, sin el prefijo /api/v1.
#
# Opcional en desarrollo: sin esta variable el cliente deduce el host del propio
# servidor de Metro y usa el puerto 8080 (ver src/lib/config.ts), que es lo que
# hace que funcione igual en web, en emulador y en un teléfono real.
#
# Se inlinea en el bundle (variable pública de Expo): no poner secretos acá.
# EXPO_PUBLIC_API_URL=http://192.168.1.40:8080
