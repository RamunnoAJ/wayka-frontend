{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/clinical/**",
              "components/core/**",
              "components/navigation/**",
              "ui_kits/clinica-web/**",
              "ui_kits/tutor-movil/**",
              "ui_kits/vet-movil/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Satoshi|Satoshi Static))/i]",
        "message": "Font not provided by the design system. Available: Satoshi, Satoshi Static."
      },
      {
        "selector": "JSXOpeningElement[name.name='AllergyChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|severity|key|ref|className|style|children)$/]",
        "message": "<AllergyChip> doesn't accept that prop. Declared props: label, severity."
      },
      {
        "selector": "JSXOpeningElement[name.name='AllergyChip'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:alta|media|baja)$/]",
        "message": "<AllergyChip> severity must be one of 'alta' | 'media' | 'baja'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppointmentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|time|title|patient|vet|actions|compact|key|ref|className|style|children)$/]",
        "message": "<AppointmentCard> doesn't accept that prop. Declared props: status, time, title, patient, vet, actions, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppointmentCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:pendiente|cumplido|vencido)$/]",
        "message": "<AppointmentCard> status must be one of 'pendiente' | 'cumplido' | 'vencido'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|species|tone|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, size, species, tone."
      },
